# Security headers for static hosting (Cloudflare Workers/Pages, Netlify).
#
# The Node server sends these itself; a static deploy has no server, so without
# this file the site ships with none of them. Keep the two in step.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://*.firebaseio.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com wss://*.firebaseio.com; frame-src https://*.firebaseapp.com https://accounts.google.com; form-action 'self' https://accounts.google.com https://*.firebaseapp.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Images are content-stable: the globe textures never change without being
# renamed, so they can sit in cache for a year.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Scripts and styles change on every deploy and their filenames do not, so a
# long cache would keep visitors on old code for days. They revalidate instead,
# which is one cheap 304 per file.
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate
