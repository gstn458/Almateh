{
  "name": "radar",
  "version": "1.0.0",
  "private": true,
  "description": "A verified opportunity directory, matching engine and application tracker for students.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "start": "node server/index.js",
    "dev": "node scripts/build-site.mjs && node server/index.js",
    "admin": "node server/create-admin.js",
    "assets": "node scripts/render-assets.mjs",
    "test": "node scripts/journey-test.mjs && node scripts/admin-test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:all": "npm run test && npm run test:browser",
    "domain": "node scripts/set-domain.mjs"
  }
}
